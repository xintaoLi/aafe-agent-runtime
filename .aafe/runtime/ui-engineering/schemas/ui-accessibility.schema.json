{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aafe.dev/ui/ui-accessibility.schema.json",
  "title": "Accessibility Check",
  "type": "object",
  "properties": {
    "standard": {
      "type": "string",
      "enum": [
        "WCAG-2.2-AA"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "severity"
        ]
      }
    }
  },
  "required": [
    "standard"
  ]
}
