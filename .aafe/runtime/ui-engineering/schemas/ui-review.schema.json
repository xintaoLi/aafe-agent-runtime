{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aafe.dev/ui/ui-review.schema.json",
  "title": "UI Review Result",
  "type": "object",
  "properties": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "needs_fix",
        "fail"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "severity"
        ]
      }
    }
  },
  "required": [
    "score",
    "status",
    "issues"
  ]
}
