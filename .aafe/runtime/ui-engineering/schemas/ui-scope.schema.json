{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aafe.dev/ui/ui-scope.schema.json",
  "title": "UI Scope Plan",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "complexity": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "enabled",
    "skills",
    "rules"
  ]
}
