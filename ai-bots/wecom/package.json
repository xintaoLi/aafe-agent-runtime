{
  "name": "@aafe/wecom-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WeCom long-connection AI bot that creates isolated AAFE tasks.",
  "bin": {
    "aafe-wecom": "./bin/wecom.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "project:init": "node ../../bin/aafe.js bot project init --wecom --root=../..",
    "playwright:install": "playwright install chromium",
    "start": "node ../../bin/aafe.js bot start --wecom --root=../..",
    "dev": "WECOM_LOG=1 WECOM_LOG_LEVEL=debug node --watch-path=src --watch-path=../../src ../../bin/aafe.js bot start --wecom --root=../..",
    "check:models": "node ../../bin/aafe.js wecom --check-models --root=../.."
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "playwright": "^1.63.0"
  }
}
