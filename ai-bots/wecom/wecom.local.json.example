{
  "botId": "your-wecom-bot-id",
  "secret": "your-wecom-bot-secret",
  "apiKey": "crsr_your-cursor-api-key",
  "model": "grok-4.6",
  "currentWorkspace": "local",
  "workspaces": [
    {
      "id": "local",
      "name": "当前目录",
      "cwd": "."
    },
    {
      "id": "demo",
      "name": "示例远程仓",
      "repository": "owner/repo",
      "baseBranch": "main"
    }
  ],
  "log": {
    "enabled": false
  },
  "intent": {
    "enabled": true,
    "endpoint": null,
    "model": null,
    "apiKeyEnv": "AAFE_LLM_API_KEY",
    "cursorModel": null,
    "timeoutMs": 25000
  },
  "models": {
    "default": "grok-4.6",
    "rules": [
      {
        "id": "ui-polish",
        "model": "claude-sonnet-5",
        "match": "样式|css|文案|颜色",
        "note": "自定义规则示例：先跑 aafe wecom --check-models 验证"
      }
    ]
  }
}
