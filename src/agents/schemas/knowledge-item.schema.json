{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aafe.dev/schemas/knowledge-item.schema.json",
  "title": "KnowledgeItem",
  "description": "The unit the knowledge store persists. Agent output is normalized into this shape before it can influence a later run.",
  "type": "object",
  "required": ["id", "type", "name", "evidence", "confidence", "generatedBy", "validated", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "architecture",
        "dependency",
        "data-flow",
        "feature",
        "business-flow",
        "module",
        "route",
        "component",
        "impact",
        "test",
        "failure"
      ]
    },
    "name": { "type": "string" },
    "content": {},
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generatedBy": { "type": "string" },
    "validated": { "type": "boolean" },
    "updatedAt": { "type": "integer", "minimum": 0 }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["type"],
      "anyOf": [{ "required": ["file"] }, { "required": ["source"] }],
      "properties": {
        "type": { "type": "string" },
        "file": { "type": "string" },
        "reason": { "type": "string" },
        "source": { "type": "object" }
      }
    }
  }
}
