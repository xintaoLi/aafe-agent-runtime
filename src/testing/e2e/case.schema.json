{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aafe.dev/schemas/e2e-case.schema.json",
  "title": "AAFE E2E Case (AITest-compatible)",
  "description": "Compatible with @aafe/ai-test YAML Case schema so cases can be synced back.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "priority", "sources", "entry", "preconditions", "steps", "assertions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "engine": { "type": "string", "enum": ["auto", "playwright", "midscene"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source" }
    },
    "entry": { "$ref": "#/definitions/entry" },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/precondition" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/assertion" }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["quality-gate", "authoritative-doc", "tapd", "user-confirmation", "requirement"]
        },
        "ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["ref"] }, { "required": ["path"] }]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["environment", "auth", "storageState"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "enum": ["navigate", "wait", "waitApi", "tap", "select", "input", "dismiss"] },
        "target": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      },
      "required": ["action"]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "check": { "type": "string" },
        "expect": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "enum": ["primary", "auxiliary"] },
        "selector": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "tolerate": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
